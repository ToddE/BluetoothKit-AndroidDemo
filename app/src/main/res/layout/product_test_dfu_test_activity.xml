<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:theme="@style/ToolbarTheme"
        app:layout_collapseMode="pin"
        app:popupTheme="@style/ToolbarPopupTheme" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimens_20dp"
        android:layout_marginTop="@dimen/dimens_20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mDeviceNameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_device_name_label"
                android:textColor="@android:color/black"
                android:textSize="@dimen/text_sp16" />

            <TextView
                android:id="@+id/mDeviceMacTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mac"
                android:textColor="@android:color/black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimens_20dp"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/ui_current_status"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/mTestStateTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_no_device_selected"
                android:textColor="@android:color/holo_blue_light" />

        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimens_20dp"
        android:layout_marginTop="@dimen/dimens_5dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_select_bluetooth_device"
            android:textColor="@android:color/black" />

        <Spinner
            android:id="@+id/mDfuSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="textEnd" />

        <Button
            android:id="@+id/mSelectDeviceBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_select_device" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimens_20dp"
        android:layout_marginTop="@dimen/dimens_5dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_firmware_version"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/mDfuFirmwareVersionTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0.0"
            android:textColor="@android:color/black" />

        <Button
            android:id="@+id/mDfuSelectFilePathBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_select_firmware" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimens_20dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_ota_count"
                android:textColor="@android:color/black" />

            <EditText
                android:id="@+id/mDfuTestNumEt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="number"
                android:text="20"
                android:textColor="@android:color/black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/dimens_10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_current_count"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/mDfuTestCurrentNumTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textColor="@android:color/black" />

        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/dimens_20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_factory_mode" />

        <ToggleButton
            android:id="@+id/switchModeToggleBtn"
            android:layout_width="@dimen/size_dp58"
            android:layout_height="@dimen/size_dp30"
            android:background="@drawable/tone_switch_selector"
            android:checked="false"
            android:textOff=""
            android:textOn="" />


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_20dp"
        android:layout_marginHorizontal="@dimen/dimens_20dp">

        <Button
            android:id="@+id/startTestBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_start_test"
            android:textColor="@android:color/black" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:background="#11000000"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollViewLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <TextView
                android:id="@+id/logTxt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="5dp" />

        </androidx.core.widget.NestedScrollView>
    </LinearLayout>


</LinearLayout>